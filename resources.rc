#include <windows.h>
#include "resources.h"

IDI_FEATHERAPI ICON "FeatherApi.ico"

// Keep the numeric and string versions in sync when preparing a release.
1 VERSIONINFO
 FILEVERSION 2,0,2,0
 PRODUCTVERSION 2,0,2,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "yangka\0"
            VALUE "FileDescription", "FeatherApi - Lightweight API Client\0"
            VALUE "FileVersion", "2.0.2.0\0"
            VALUE "InternalName", "FeatherApi\0"
            VALUE "LegalCopyright", "Copyright (c) 2026 yangka\0"
            VALUE "OriginalFilename", "FeatherApi.exe\0"
            VALUE "ProductName", "FeatherApi\0"
            VALUE "ProductVersion", "2.0.2.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
